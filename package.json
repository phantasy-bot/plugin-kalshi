{
  "name": "@phantasy/plugin-kalshi",
  "version": "0.2.1-beta",
  "private": false,
  "description": "Kalshi prediction-market integration plugin for Phantasy.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "phantasy.plugin.json"
  ],
  "sideEffects": false,
  "keywords": [
    "phantasy",
    "plugin",
    "kalshi",
    "prediction-markets",
    "trading",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phantasy-bot/plugin-kalshi"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/phantasy-bot/plugin-kalshi",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@phantasy/agent": "^0.1.0-beta"
  },
  "peerDependenciesMeta": {
    "@phantasy/agent": {
      "optional": true
    }
  },
  "dependencies": {
    "kalshi-typescript": "^3.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "phantasy": {
    "displayName": "Kalshi",
    "category": "markets",
    "tags": [
      "kalshi",
      "prediction-markets",
      "trading",
      "finance"
    ],
    "workspace": "business",
    "extensionKind": "integration",
    "permissions": [
      "internet"
    ],
    "pluginDependencies": [],
    "platforms": [
      "node"
    ],
    "productionReady": true,
    "adminSurface": {
      "tabId": "kalshi",
      "label": "Kalshi",
      "workspace": "business",
      "kind": "generic",
      "advancedModule": "prediction-markets",
      "keywords": [
        "kalshi",
        "prediction markets",
        "finance"
      ]
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "title": "Enabled",
          "description": "Load Kalshi tools and admin surface."
        },
        "allowTrading": {
          "type": "boolean",
          "default": false,
          "title": "Allow trading",
          "description": "When on, order tools may place and cancel live orders. Toggle anytime in this plugin form — no restart required."
        },
        "environment": {
          "type": "string",
          "enum": [
            "demo",
            "production"
          ],
          "default": "demo",
          "title": "Environment",
          "description": "Use demo for practice; production places real orders when trading is allowed."
        },
        "apiKey": {
          "type": "string",
          "title": "API key ID",
          "format": "password"
        },
        "privateKeyPem": {
          "type": "string",
          "title": "RSA private key (PEM)",
          "format": "pem"
        }
      }
    },
    "data": {
      "stores": [
        {
          "name": "agent_configs.kalshiConfig",
          "kind": "config",
          "description": "Kalshi API environment and operator configuration.",
          "erasable": false
        }
      ],
      "dataCategories": [
        "prediction market account metadata",
        "market orders",
        "positions",
        "financial activity"
      ],
      "externalServices": [
        "Kalshi API"
      ],
      "retentionDefault": "persist",
      "erasable": false
    }
  }
}
