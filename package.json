{
  "name": "@phantasy/plugin-kalshi",
  "version": "2.0.0",
  "description": "Installable Kalshi prediction-market plugin surface for Phantasy",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "ai",
    "agent",
    "plugin",
    "kalshi",
    "markets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasy-bot/agent.git"
  },
  "bugs": {
    "url": "https://github.com/phantasy-bot/agent/issues"
  },
  "homepage": "https://github.com/phantasy-bot/agent#readme",
  "dependencies": {
    "@phantasy/agent": "^2.0.0"
  },
  "phantasy": {
    "displayName": "Kalshi",
    "category": "markets",
    "tags": [
      "kalshi",
      "prediction-markets",
      "trading",
      "finance"
    ],
    "workspace": "business",
    "extensionKind": "integration",
    "permissions": [
      "internet"
    ],
    "platforms": [
      "node"
    ],
    "productionReady": false,
    "adminSurface": {
      "tabId": "kalshi",
      "label": "Kalshi",
      "section": "business",
      "workspace": "business",
      "kind": "generic",
      "advancedModule": "prediction-markets",
      "keywords": [
        "kalshi",
        "prediction markets",
        "finance"
      ]
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "apiKey": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "default": "demo"
        }
      }
    }
  }
}
